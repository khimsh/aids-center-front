---

<section class="programs" id="programs" aria-labelledby="programs-title">
  <div class="container">
    <div class="programs-header">
      <div>
        <p class="section-label">Free State Programs</p>
        <h2 class="section-title" id="programs-title">
          Healthcare available to you,<br />at no cost
        </h2>
      </div>
      <a href="#" class="view-all">All Programs →</a>
    </div>
    <div class="programs-grid">
      <div class="program-card hiv">
        <div class="program-badge">HIV / AIDS</div>
        <h3 class="program-title">Free Anonymous HIV Testing & Consultation</h3>
        <p class="program-desc">
          Confidential testing for HIV infection with same-day results.
          Available to anyone regardless of risk level. No referral needed.
        </p>
        <a href="#" class="program-link">Learn more & book</a>
      </div>

      <div class="program-card hep">
        <div class="program-badge">Hepatitis B</div>
        <h3 class="program-title">
          Free Hepatitis B Diagnosis & Treatment Program
        </h3>
        <p class="program-desc">
          State-funded diagnosis and treatment for Hepatitis B, available to all
          Georgian citizens. Includes full diagnostic workup.
        </p>
        <a href="#" class="program-link">Check eligibility</a>
      </div>

      <div class="program-card prep">
        <div class="program-badge">Prevention</div>
        <h3 class="program-title">PrEP Prophylaxis — HIV Prevention Program</h3>
        <p class="program-desc">
          Pre-exposure prophylaxis for individuals at high risk of HIV
          infection. Provided free of charge through the state healthcare
          program.
        </p>
        <a href="#" class="program-link">Find out more</a>
      </div>
    </div>
  </div>
</section>

<style>
  .programs {
    padding: 72px 0;
    background: var(--white);
  }

  .programs-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 36px;
    gap: 24px;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .program-card {
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    border: 1.5px solid var(--gray-200);
    transition:
      box-shadow 0.2s,
      transform 0.2s;
    position: relative;
    overflow: hidden;
  }

  .program-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
  }

  .program-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .program-card.hiv {
    background: #fff5f5;
  }
  .program-card.hiv::before {
    background: var(--red);
  }

  .program-card.hep {
    background: var(--orange-bg);
  }
  .program-card.hep::before {
    background: #d97706;
  }

  .program-card.prep {
    background: var(--green-bg);
  }
  .program-card.prep::before {
    background: #16a34a;
  }

  .program-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 100px;
    margin-bottom: 14px;
  }

  .program-card.hiv .program-badge {
    background: rgba(192, 21, 42, 0.1);
    color: var(--red);
  }
  .program-card.hep .program-badge {
    background: rgba(217, 119, 6, 0.12);
    color: #b45309;
  }
  .program-card.prep .program-badge {
    background: rgba(22, 163, 74, 0.1);
    color: #166534;
  }

  .program-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--navy);
    line-height: 1.3;
    margin-bottom: 10px;
  }

  .program-desc {
    font-size: 0.85rem;
    color: var(--gray-600);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  .program-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--navy);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .program-link::after {
    content: "→";
    transition: transform 0.15s;
  }

  .program-link:hover::after {
    transform: translateX(3px);
  }
</style>
