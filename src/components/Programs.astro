---
import ProgramCard from "../components/ProgramCard.astro";
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
---

<section
  class="programs content-grid"
  id="programs"
  aria-labelledby="programs-title"
>
  <div class="container">
    <div class="programs-header">
      <div>
        <p class="section-label">{t.programs.label}</p>
        <h2
          class="section-title"
          id="programs-title"
          set:html={t.programs.title}
        />
      </div>
      <a href="#" class="view-all">{t.programs.linkText} →</a>
    </div>
    <div class="programs-grid">
      <ProgramCard
        badge={t.programs.hivAids}
        title={t.programs.hivAidsTitle}
        description={t.programs.hivAidsDescription}
        ctaText={t.programs.hivAidsCta}
        href="/programs/hiv"
        variant="hiv"
      />

      <ProgramCard
        badge={t.programs.hepatitisB}
        title={t.programs.hepatitisBTitle}
        description={t.programs.hepatitisBDescription}
        ctaText={t.programs.hepatitisBCta}
        href="/programs/hep"
        variant="hep"
      />

      <ProgramCard
        badge={t.programs.prevention}
        title={t.programs.preventionTitle}
        description={t.programs.preventionDescription}
        ctaText={t.programs.preventionCta}
        href="/programs/prep"
        variant="prep"
      />
    </div>
  </div>
</section>

<style>
  .programs {
    margin-block: 4rem;
  }
  .programs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    margin-bottom: 0.5rem;
    color: #fff;
    background-color: oklch(from var(--primary) l c h);
    font-size: 1rem;
    font-family: "BPG Mrgvlovani Caps", sans-serif;
    text-box: trim-both cap text;

    html[lang="en"] & {
      font-family: "Playfair Display", serif;
    }
  }
</style>
