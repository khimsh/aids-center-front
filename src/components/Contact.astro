            fill="#00378E"></path>
        </svg>
        {t.contact.email}
      </li>
    </ul>
  </div>
</div>

<style>
  .contact {
    padding-block: 4rem;
  }

  ul {
    display: grid;
    gap: 1rem;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Noto Sans Georgian", sans-serif;
  }
</style>
