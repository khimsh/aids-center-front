---
interface Props {
  badge: string;
  title: string;
  description: string;
  ctaText: string;
  href?: string;
  variant?: "hiv" | "hep" | "prep";
}

const {
  badge,
  title,
  description,
  ctaText,
  href = "#",
  variant = "hiv",
} = Astro.props as Props;
---

<div class={`program-card`} data-variant={variant}>
  <div class="program-badge">{badge}</div>
  <h3 class="program-title">{title}</h3>
  <p class="program-desc">{description}</p>
  <a href={href} class="program-link">
    {ctaText}

    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm4.28 10.28a.75.75 0 0 0 0-1.06l-3-3a.75.75 0 1 0-1.06 1.06l1.72 1.72H8.25a.75.75 0 0 0 0 1.5h5.69l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3Z"
        clip-rule="evenodd"></path>
    </svg>
  </a>
</div>

<style>
  .program-card {
    display: grid;
    gap: 12px;
    background-color: #fff;
    padding: 16px;
    border-radius: 10px;
  }

  .program-badge {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
    font-size: 14px;
    font-weight: 500;
    font-family: "Noto Sans Georgian", sans-serif;
    color: oklch(from var(--primary) 90% c h);
    background-color: oklch(from var(--primary) 20% c h);
    border-radius: 10px;
  }

  .program-title {
    font-size: 20px;
    font-weight: 700;
    font-family: "BPG Nino Mtavruli Bold", serif;
    color: #313131;
  }

  .program-desc {
    font-size: 14px;
    font-family: "Noto Sans Georgian", sans-serif;
    color: #454545;
  }

  .program-link {
    justify-self: start;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 14px;
    font-weight: 500;
    font-family: "Noto Sans Georgian", sans-serif;
    color: var(--primary);
    text-decoration: none;

    &::before {
      content: "";
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 100%;
      height: 2px;
      background-color: var(--primary);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.3s ease;
    }

    &:hover::before {
      transform: scaleX(1);
      transform-origin: left;
    }

    svg {
      flex-shrink: 0;
      width: 24px;
      height: 24px;
    }
  }
</style>
