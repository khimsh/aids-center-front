---
import ProgramCard from "./ProgramCard.astro";
import { useTranslations } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
---

<section
  class="programs content-grid"
  id="programs"
  aria-labelledby="programs-title"
>
  <div class="container">
    <div class="programs-header">
      <h2
        class="section-title"
        id="programs-title"
        set:html={t.programs.label}
      />
    </div>
    <div class="programs-grid">
      <ProgramCard
        badge={t.programs.hivAids}
        title={t.programs.hivAidsTitle}
        description={t.programs.hivAidsDescription}
        ctaText={t.programs.hivAidsCta}
        href="/programs/hiv"
        variant="hiv"
      />

      <ProgramCard
        badge={t.programs.hepatitisB}
        title={t.programs.hepatitisBTitle}
        description={t.programs.hepatitisBDescription}
        ctaText={t.programs.hepatitisBCta}
        href="/programs/hep"
        variant="hep"
      />

      <ProgramCard
        badge={t.programs.prevention}
        title={t.programs.preventionTitle}
        description={t.programs.preventionDescription}
        ctaText={t.programs.preventionCta}
        href="/programs/prep"
        variant="prep"
      />
    </div>

    <a href="#" class="section-view-all">
      {t.programs.linkText}

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
          d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm4.28 10.28a.75.75 0 0 0 0-1.06l-3-3a.75.75 0 1 0-1.06 1.06l1.72 1.72H8.25a.75.75 0 0 0 0 1.5h5.69l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3Z"
          clip-rule="evenodd"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .programs {
    padding-block: 8rem;
    background-color: var(--primary);
  }

  .programs-grid {
    margin-bottom: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .section-title {
    color: #ebebeb;
  }
</style>
