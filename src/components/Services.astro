---
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
---

<section class="services">
  <div class="container">
    <h2 class="services-title geo-font-bold">{t.services.title}</h2>
    <div class="services-grid">
      <div>
        <h3 class="geo-font-bold services-subtitle">
          {t.services.diagnostics.title}
        </h3>
        <ul>
          <li>{t.services.diagnostics.CT}</li>
          <li>{t.services.diagnostics.XRAY}</li>
          <li>{t.services.diagnostics.ultrasound}</li>
          <li>{t.services.diagnostics.fibroelastography}</li>
          <li>{t.services.diagnostics.pletismography}</li>
        </ul>
      </div>
      <div>
        <h3 class="geo-font-bold services-subtitle">
          {t.services.extraCorporalMethods.title}
        </h3>
        <ul>
          <li>{t.services.extraCorporalMethods.plasmapheresis}</li>
          <li>{t.services.extraCorporalMethods.thrombocytapheresis}</li>
          <li>{t.services.extraCorporalMethods.ctemCellMobilization}</li>
          <li>{t.services.extraCorporalMethods.kidneyReplacementTherapy}</li>
        </ul>
      </div>
      <div>
        <h3 class="geo-font-bold services-subtitle">
          {t.services.laboratory.title}
        </h3>
        <ul>
          <li>{t.services.laboratory.clinicalBiochemistry}</li>
          <li>{t.services.laboratory.hivAids}</li>
          <li>{t.services.laboratory.bacterial}</li>
          <li>{t.services.laboratory.immunology}</li>
          <li>{t.services.laboratory.other}</li>
        </ul>
      </div>
    </div>
  </div>
</section>
