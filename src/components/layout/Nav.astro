---
import { Icon } from 'astro-icon/components';

import { useTranslations } from '../../i18n/utils';

const lang = (Astro.currentLocale ?? 'ka') as 'ka' | 'en';
const t = useTranslations(lang);
const homeUrl = lang === 'ka' ? '/' : `/${lang}`;
const newsUrl = lang === 'ka' ? '/news' : `/${lang}/news`;
const hivAidsUrl = lang === 'ka' ? '/hiv-aids' : `/${lang}/hiv-aids`;
const aboutUrl = lang === 'ka' ? '/about' : `/${lang}/about`;
const doctorsUrl = lang === 'ka' ? '/doctors' : `/${lang}/doctors`;
const legislationUrl = lang === 'ka' ? '/legislation' : `/${lang}/legislation`;
const palliativeCareUrl = lang === 'ka' ? '/palliative-care' : `/${lang}/palliative-care`;
const etiopathogenesisUrl = lang === 'ka' ? '/etiopathogenesis' : `/${lang}/etiopathogenesis`;
const clinicalSpectrumUrl = lang === 'ka' ? '/clinical-spectrum' : `/${lang}/clinical-spectrum`;
const diagnosticUrl = lang === 'ka' ? '/diagnostic' : `/${lang}/diagnostic`;
const importantDatesUrl = lang === 'ka' ? '/important-dates' : `/${lang}/important-dates`;

const labUrl = lang === 'ka' ? '/laboratory' : `/${lang}/laboratory`;
const transmissionUrl = lang === 'ka' ? '/transmission' : `/${lang}/transmission`;
---

<nav aria-label={t.nav.navAriaLabel} class="main-nav">
  <ul class="nav-list">
    <li>
      <a href={homeUrl}>{t.nav.home}</a>
    </li>

    <li>
      <button class="nav-dropdown-btn" aria-expanded="false"
        >{t.nav.hivAids} <Icon name="heroicons:chevron-down" /></button
      >
      <ul class="nav-dropdown">
        <li>
          <a href={hivAidsUrl}>{t.nav.aboutHivAids}</a>
        </li>
        <li>
          <a href="#">{t.nav.getTested}</a>
        </li>
        <li>
          <a href={transmissionUrl}>{t.nav.waysOfTransmission}</a>
        </li>
        <li>
          <a href="#">{t.nav.prevention}</a>
        </li>
        <li>
          <a href="#">{t.nav.treatment}</a>
        </li>
        <li>
          <a href="#">{t.nav.livingWithHiv}</a>
        </li>
        <li>
          <span class="nav-group-title">{t.nav.forProfessionals}</span>
          <ul class="nav-subgroup">
            <li>
              <a href={etiopathogenesisUrl}>{t.nav.etiopathogenesis}</a>
            </li>
            <li>
              <a href={clinicalSpectrumUrl}>{t.nav.clinicalSpectrum}</a>
            </li>
            <li>
              <a href={diagnosticUrl}>{t.nav.diagnostic}</a>
            </li>
            <li>
              <a href={palliativeCareUrl}>{t.nav.palliativeCare}</a>
            </li>
          </ul>
        </li>
        <li>
          <a href="#">{t.nav.epidemiologicalSituationStats}</a>
        </li>
        <li>
          <a href={legislationUrl}>{t.nav.legislation}</a>
        </li>
        <li>
          <a href={importantDatesUrl}>{t.nav.importantDates}</a>
        </li>
        <li>
          <a href="#">{t.nav.qa}</a>
        </li>
      </ul>
    </li>

    <li>
      <a href="#">{t.nav.hepatitis}</a>
    </li>

    <li>
      <a href="#">{t.nav.infectiousDiseases}</a>
    </li>

    <li>
      <a href={newsUrl}>{t.nav.news}</a>
    </li>

    <li>
      <button class="nav-dropdown-btn" aria-expanded="false">
        {t.nav.about} <Icon name="heroicons:chevron-down" /></button
      >
      <ul class="nav-dropdown">
        <li>
          <a href={aboutUrl}>{t.nav.about}</a>
        </li>
        <li>
          <a href={doctorsUrl}>{t.nav.ourDoctors}</a>
        </li>
      </ul>
    </li>

    <li>
      <button class="nav-dropdown-btn" aria-expanded="false"
        >{t.nav.services} <Icon name="heroicons:chevron-down" /></button
      >
      <ul class="nav-dropdown">
        <li>
          <a href="#">{t.nav.ambulatory}</a>
        </li>
        <li>
          <a href="#">{t.nav.stationary}</a>
        </li>
        <li>
          <a href="#">{t.nav.instrumentalDiagnostics}</a>
        </li>
        <li>
          <a href="#">{t.nav.scientificResearch}</a>
        </li>
        <li>
          <a href={labUrl}>{t.nav.laboratory}</a>
        </li>
      </ul>
    </li>

    <li>
      <a href="#">{t.nav.contact}</a>
    </li>
  </ul>
</nav>

<style>
  .main-nav {
    position: relative;
    z-index: 1;
  }

  .nav-list {
    display: flex;
    gap: 1rem;
  }

  .nav-dropdown {
    list-style: none;
    position: absolute;
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    color: #fff;
    background-color: var(--primary);
    border-radius: 4px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;

    &.is-open {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(10px);
    }

    a {
      color: #fff;
      font-size: 0.85rem;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .nav-dropdown > li,
  .nav-subgroup {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-group-title {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #fff;
    font-size: 0.85rem;
  }

  .nav-group-title::after {
    content: '>';
    opacity: 0.8;
  }

  .nav-subgroup {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.45rem;
    padding-left: 1rem;
  }

  .nav-dropdown-btn {
    position: relative;
    background-color: transparent;
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: inherit;
    cursor: pointer;

    [data-icon] {
      transition: transform 0.2s ease;
    }

    &[aria-expanded='true'] [data-icon] {
      transform: rotate(180deg);
    }
  }

  li,
  a,
  button {
    font-size: 0.9rem;
    font-family: 'Noto Sans Georgian', sans-serif;
    font-weight: 500;
    color: oklch(from var(--primary) 20% c h);
  }

  .nav-list > li > a,
  .nav-list > li > button {
    transition:
      color 0.2s ease,
      opacity 0.2s ease;

    &:hover {
      color: var(--primary);
    }
  }

  .nav-list > li > button[aria-expanded='true'] {
    color: var(--primary);
  }
</style>

<script>
  // Toggle mobile menu
  const menuToggle = document.querySelector('.menu-toggle');
  const mainNav = document.querySelector('.main-nav');

  if (menuToggle && mainNav) {
    menuToggle.addEventListener('click', () => {
      mainNav.classList.toggle('is-open');
    });
  }

  // Dropdown toggle
  const dropdownBtns = document.querySelectorAll<HTMLButtonElement>('.nav-dropdown-btn');

  dropdownBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const dropdown = btn.nextElementSibling as HTMLElement | null;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all other open dropdowns
      dropdownBtns.forEach((other) => {
        if (other !== btn) {
          other.setAttribute('aria-expanded', 'false');
          (other.nextElementSibling as HTMLElement | null)?.classList.remove('is-open');
        }
      });

      btn.setAttribute('aria-expanded', String(!isOpen));
      dropdown?.classList.toggle('is-open', !isOpen);
    });
  });

  // Close dropdowns when clicking outside
  document.addEventListener('click', () => {
    dropdownBtns.forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
      (btn.nextElementSibling as HTMLElement | null)?.classList.remove('is-open');
    });
  });
</script>
