---
import { useTranslations } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
---

<div class="topbar content-grid" role="banner">
  <div class="topbar-inner">
    <div class="topbar-item">
      <div class="dot"></div>
      <span class="label">{t.topbar.hivAidsHotline}</span>
      <a href="tel:+995551826666" class="number">551 826 666</a>
    </div>
    <div class="topbar-item">
      <div class="dot"></div>
      <span class="label">{t.topbar.hepatitisB}</span>
      <a href="tel:+995551816666" class="number">551 816 666</a>
    </div>
    <div class="topbar-item">
      <div class="dot"></div>
      <span class="label">{t.topbar.ambulatory}</span>
      <a href="tel:+995557252784" class="number">557 252 784</a>
    </div>
    <div class="topbar-item topbar-emergency">
      <div class="dot"></div>
      <span class="label">{t.topbar.emergency}</span>
      <a href="tel:+995595395566" class="number">595 395 566</a>
    </div>
  </div>
</div>

<style>
  .topbar {
    background-color: oklch(from var(--primary) 94% c h);
    padding: 10px 0;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .topbar-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--primary);
  }

  .topbar-item .label {
    font-weight: 400;
  }

  .topbar-item .number {
    font-weight: 700;
    color: var(--primary);
    letter-spacing: 0.3px;
  }

  .topbar-item .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: oklch(from var(--primary) l 40 h);
    flex-shrink: 0;
  }

  .topbar-emergency .number {
    color: oklch(from var(--primary) l 0.3 h);
  }
</style>
