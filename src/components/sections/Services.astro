        ></path>
        <path
          d="M10.6589 39.9999V37.3333H26.6361V39.9999H10.6589Z"
          fill="#00378E"></path>
      </svg>

      <h3 class="services-subtitle">
        {t.services.diagnostics.title}
      </h3>
      <ul class="services-list">
        <li>{t.services.diagnostics.CT}</li>
        <li>{t.services.diagnostics.XRAY}</li>
        <li>{t.services.diagnostics.ultrasound}</li>
        <li>{t.services.diagnostics.fibroelastography}</li>
        <li>{t.services.diagnostics.pletismography}</li>
      </ul>
    </div>
