---
import { useTranslations } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
---

<section class="services content-grid" aria-labelledby="services-title">
  <div>
    <p class="section-label">{t.services.title}</p>
    <h2 id="services-title" class="section-title">
      {t.services.heading}
    </h2>
  </div>

  <div class="services-grid">
    <div class="services-card">
      <svg
