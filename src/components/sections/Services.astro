          fill="#00378E"></path>
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M36.0878 39.8897C36.0875 39.8898 36.0882 39.8897 36.0878 39.8897C34.2023 40.8326 31.8452 43.1896 31.3738 44.6037L40.3304 53.5606C43.9754 57.2054 49.8848 57.2054 53.5298 53.5605C57.1746 49.9157 57.1747 44.0061 53.5298 40.3613L50.7019 37.5334L42.2172 46.018L36.0878 39.8897Z"
