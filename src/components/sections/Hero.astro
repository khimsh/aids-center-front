---
import { Icon } from 'astro-icon/components';
import { useTranslations } from '../../i18n/utils';

const lang = (Astro.currentLocale ?? 'ka') as 'ka' | 'en';
const t = useTranslations(lang);

import ClinicPhoto from '../../assets/images/clinic.webp';
---

<section class="hero content-grid">
  <div class="hero-content">
    <div>
      <div class="hero-text">
        <h2 set:html={t.hero.title} class="hero-title geo-font-bold" />
        <p set:html={t.hero.description} class="hero-desc geo-font-bold" />
      </div>

      <!-- CTAs -->
      <ul class="hero-ctas">
        <li>
          <a href="tel:+995551826666" class="btn-primary">
            {t.topbar.hivAidsHotline}
          </a>
        </li>
        <li>
          <a href="#" class="btn-secondary"> {t.hero.contactUs}</a>
        </li>
      </ul>
    </div>

    <div>
      <figure class="hero-image">
        <img src={ClinicPhoto.src} alt="New Clinic" class="hero-image" />
        <figcaption class="hero-image-pin">
          {(<Icon name="heroicons:map-pin" />)}
          {t.hero.address}
        </figcaption>
      </figure>
    </div>
  </div>
  <!-- .hero-content -->
</section>

<style>
  .hero {
    padding-block: 2rem 4rem;
  }

  .hero-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    align-items: center;
    gap: 2rem;
  }

  .hero-title {
    font-size: 1.65rem;
    margin-bottom: 1rem;
    color: #034485;
    text-wrap: balance;
    font-family: 'BPG Nino Mtavruli Bold', sans-serif;

    html[lang='en'] & {
      font-family: 'Satoshi', sans-serif;
    }
  }

  .hero-desc {
    font-size: 1rem;
    margin-bottom: 2rem;
    font-family: 'Noto Sans Georgian', sans-serif;
    text-wrap: balance;
  }

  .hero-image {
    width: 100%;
    border-radius: 10px;
    object-fit: cover;
    background-position: bottom;
    box-shadow: 0 6px 10px rgba(0, 0, 0, 0.16);
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
  }

  .btn-primary {
    background-color: #034485;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: 10em;
    font-size: 1rem;
    transition: background-color 0.3s ease;
    border: 2px solid #034485;
    white-space: nowrap;
    &:hover {
      background-color: #022f6c;
    }
  }

  .btn-secondary {
    background-color: transparent;
    color: #034485;
    padding: 0.75rem 1.5rem;
    border-radius: 10em;
    font-size: 1rem;
    border: 2px solid #034485;
    white-space: nowrap;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
    &:hover {
      background-color: #034485;
      color: #fff;
    }
  }

  .hero-image {
    position: relative;

    img {
      display: block;
    }
  }

  .hero-image-pin {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #fff;
    color: oklch(0 0 0 / 0.86);
    padding: 0.6rem;
    border-radius: 4px;
    max-width: 36ch;

    svg {
      flex-shrink: 0;
      width: 1.5em;
      height: 1.5em;
    }
  }
</style>
