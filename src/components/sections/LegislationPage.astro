              'აივ/შიდსით დაავადებულ პაციენტთა და მათთან კონტაქტში მყოფ პირთა პრევენციული მეთვალყურეობა',
            clauses: [
              'პირები, რომლებმაც ჩაიტარეს ტესტირება და დადებითი შედეგი მიიღეს, წერილობით ეცნობებათ პრევენციის წესები ჯანდაცვის ორგანოების მიერ. პაციენტი ხელს აწერს, რომ გაეცნო წესებს. თუ მცირეწლოვნობის, ფსიქიკური მდგომარეობის ან სხვა მიზეზის გამო პაციენტი ვერ შეასრულებს წესებს, შეტყობინება ეგზავნება კანონიერ წარმომადგენელს.',
              'საქართველოს მოქალაქეები, უცხო ქვეყნის მოქალაქეები და იძულებით გადაადგილებული პირები, რომლებშიც გამოვლინდა აივ ინფექცია, ასევე მათთან კონტაქტში ყოფილი პირები ვალდებულნი არიან გაიარონ პრევენციული მეთვალყურეობა.',
            ],
          },
          {
            number: '7',
            title: 'აივ/შიდსით დაავადებულ პაციენტთა სკრინინგი, მკურნალობა და სტაციონარული კონტროლი',
            clauses: [
              'საქართველოს შრომის, ჯანმრთელობისა და სოციალური დაცვის სამინისტროს სპეციალიზებული ანტი-აივ/შიდს სამსახური ახორციელებს პაციენტების კლინიკური და ლაბორატორიული სკრინინგის, მკურნალობისა და სტაციონარული კონტროლის ზედამხედველობას.',
              'სამინისტრო ადგენს უსახელო პაციენტების სკრინინგის, მკურნალობისა და მეთვალყურეობის პროცედურებს ამ კანონის შესაბამისად.',
              'კლინიკური და ლაბორატორიული სკრინინგის, მკურნალობისა და სტაციონარული კონტროლის ხარჯები ანაზღაურდება ჯანმრთელობის დაცვის მოქმედი კანონმდებლობის შესაბამისად.',
            ],
          },
        ],
      },
    ] as Chapter[],
    noteTitle: 'შენიშვნა',
    noteText:
      'ეს არის საქართველოს კანონის ინფორმაციული პრეზენტაცია. ოფიციალური სამართლებრივი ტექსტისთვის გთხოვთ მიმართოთ საქართველოს საკანონმდებლო მაცნეს:',
    noteLinkLabel: 'matsne.gov.ge',
  },
} as const;

const c = content[lang];
---

<section class="legislation-page content-grid">
  <nav class="breadcrumbs" aria-label={breadcrumb.aria}>
    <a href={homeUrl}>{breadcrumb.home}</a>
    <span>/</span>
    <a href={hivAidsUrl}>{breadcrumb.hivAids}</a>
    <span>/</span>
    <span aria-current="page">{c.pageTitle}</span>
  </nav>

  <div class="hero">
    <p class="section-label">{c.pageTitle}</p>
    <h1>{c.heroTitle}</h1>
    <p class="hero-subtitle">{c.heroSubtitle}</p>
  </div>

  <div class="surface intro">
    <h2>{c.introTitle}</h2>
    <p>{c.introText}</p>
  </div>

  <div class="surface chapters">
    <h2>{c.chaptersTitle}</h2>
    <div class="chapter-list">
      {
        c.chapters.map((chapter) => (
          <details class="chapter" open={chapter.number === 'I'}>
            <summary class="chapter-summary">
              <span class="chapter-badge">Chapter {chapter.number}</span>
              <span class="chapter-title">{chapter.title}</span>
              <span class="chevron" aria-hidden="true" />
            </summary>
            <div class="chapter-body">
              {chapter.articles.map((article) => (
                <article class="law-article">
                  <h4 class="article-title">
                    <span class="article-num">Article {article.number}.</span> {article.title}
                  </h4>
                  <ol class="clause-list">
                    {article.clauses.map((clause) => (
                      <li>{clause}</li>
                    ))}
                  </ol>
                </article>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>

  <div class="surface note">
    <p>
      <strong>{c.noteTitle}:</strong>
      {' '}
      {c.noteText}{' '}
      <a href={matsneUrl} target="_blank" rel="noreferrer noopener">
        {c.noteLinkLabel}
      </a>
    </p>
  </div>
</section>

<style>
  .legislation-page {
    padding-block: 4rem 5rem;
    display: grid;
    gap: 1.5rem;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: #64748b;
  }

  .breadcrumbs a {
    color: #0f172a;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  .hero {
    background: linear-gradient(135deg, #002f66 0%, #0452a3 100%);
    border-radius: 16px;
    padding: 2rem;
    color: #f3f7ff;

    h1 {
      font-size: clamp(1.4rem, 2.8vw, 2.2rem);
      line-height: 1.25;
      margin-bottom: 0.75rem;
    }
  }

  .hero-subtitle {
    color: #d8e6ff;
    font-size: 1.05rem;
  }

  .surface {
    background: #fff;
    border-radius: 14px;
    padding: 1.5rem;
    box-shadow: 0 8px 24px rgba(3, 68, 133, 0.08);

    h2 {
      margin-bottom: 1rem;
      font-size: 1.35rem;
      color: #02386f;
    }

    p {
      line-height: 1.7;
      color: #223549;
    }
  }

  /* Chapter accordions */
  .chapter-list {
    display: grid;
    gap: 0.75rem;
  }

  .chapter {
    border: 1px solid #d8e4f2;
    border-radius: 12px;
    overflow: hidden;
  }

  .chapter-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    cursor: pointer;
    background: #f3f8ff;
    list-style: none;
    user-select: none;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover {
      background: #e8f1fd;
    }
  }

  .chapter-badge {
    flex-shrink: 0;
    background: #0b4d95;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .chapter-title {
    flex: 1;
    font-weight: 600;
    color: #023472;
    font-size: 0.95rem;
  }

  .chevron {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-right: 2px solid #0b4d95;
    border-bottom: 2px solid #0b4d95;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
    margin-right: 0.25rem;
  }

  details[open] .chevron {
    transform: rotate(-135deg);
  }

  .chapter-body {
    padding: 1.1rem;
    display: grid;
    gap: 1.25rem;
    border-top: 1px solid #d8e4f2;
  }

  .law-article {
    display: grid;
    gap: 0.65rem;
  }

  .article-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: #12365a;
    line-height: 1.4;
  }

  .article-num {
    color: #0b4d95;
  }

  .clause-list {
    padding-left: 1.4rem;
    display: grid;
    gap: 0.55rem;
    list-style: decimal;

    li {
      font-size: 0.88rem;
      line-height: 1.7;
      color: #2e4560;
    }
  }

  .note {
    background: oklch(from #034485 94% c h);
    border-left: 4px solid #034485;
    box-shadow: none;

    p {
      font-size: 0.88rem;
      color: #1a3a5c;
    }

    a {
      color: #034485;
      font-weight: 700;
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }
  }

  @media (max-width: 680px) {
    .legislation-page {
      padding-block: 2.5rem 4rem;
    }

    .hero,
    .surface {
      padding: 1.1rem;
    }

    .chapter-summary {
      padding: 0.85rem;
      gap: 0.5rem;
    }
  }
</style>
