---
import Article from '../content/Article.astro';
import { useTranslations } from '../../i18n/utils';
import { fetchArticleBySlug, getArticlesApiBase, toAbsoluteImageUrl } from '../../lib/articles-api';
import fallbackNewsImage from '../../assets/images/clinic.webp';

const lang = (Astro.currentLocale ?? 'ka') as 'ka' | 'en';
const t = useTranslations(lang);
const archiveHref = lang === 'en' ? '/en/news' : '/news';

type ArticleApiRecord = {
  id: number;
  slug?: string | null;
  title_ka?: string | null;
  title_en?: string | null;
  body_ka?: string | null;
  body_en?: string | null;
  image_url?: string | null;
  category?: string | null;
  featured?: boolean;
  published?: boolean;
  published_at?: string | null;
  updated_at?: string | null;
  created_at?: string | null;
};

type ArticlesResponse =
  | ArticleApiRecord[]
  | {
      items?: ArticleApiRecord[];
      total?: number;
    };

const API_BASE = getArticlesApiBase();
const ARTICLES_URL = `${API_BASE}/api/articles`;

const resolveArticleImageUrl = (value?: string | null) =>
  toAbsoluteImageUrl(API_BASE, value) || fallbackNewsImage.src;

const stripHtml = (value: string) =>
  value
    .replace(/<[^>]*>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const isPublished = (entry: ArticleApiRecord) => {
  if (typeof entry.published === 'boolean') {
    return entry.published;
  }

  if (entry.published == null && entry.published_at == null) {
    // Some backends expose only already-published records on this endpoint.
    return true;
  }

  return Boolean(entry.published_at);
};

let records: ArticleApiRecord[] = [];

try {
  let response = await fetch(`${ARTICLES_URL}?page=1&per_page=20`);

  if (!response.ok && response.status === 422) {
    response = await fetch(`${ARTICLES_URL}`);
  }

  if (response.ok) {
    const data = (await response.json()) as ArticlesResponse;
    records = Array.isArray(data) ? data : (data.items ?? []);
  }
} catch {
  records = [];
}

const recordsWithBody = await Promise.all(
  records.map(async (entry) => {
    const hasBody = Boolean((entry.body_ka ?? '').trim() || (entry.body_en ?? '').trim());

    if (hasBody || !entry.slug?.trim()) {
      return entry;
    }

    const detail = await fetchArticleBySlug(API_BASE, entry.slug.trim());
    if (!detail) {
      return entry;
    }

    return {
      ...entry,
      body_ka: detail.body_ka ?? entry.body_ka,
      body_en: detail.body_en ?? entry.body_en,
    };
  }),
);

const newsItems = recordsWithBody
  .filter((entry) => isPublished(entry))
  .sort((a, b) => {
    const dateA = new Date(a.published_at ?? a.updated_at ?? a.created_at ?? 0).getTime();
    const dateB = new Date(b.published_at ?? b.updated_at ?? b.created_at ?? 0).getTime();
    return dateB - dateA;
  })
  .slice(0, 3)
  .map((entry) => {
    const localizedTitle =
      lang === 'en' ? (entry.title_en ?? entry.title_ka) : (entry.title_ka ?? entry.title_en);
    const localizedBody =
      lang === 'en' ? (entry.body_en ?? entry.body_ka) : (entry.body_ka ?? entry.body_en);
    const plainBody = stripHtml(localizedBody ?? '');

    return {
      id: entry.id,
      title:
        localizedTitle?.trim() || (lang === 'en' ? 'Untitled Article' : 'სტატიის სათაურის გარეშე'),
      articleTag: entry.category ?? 'news',
      content: plainBody || (lang === 'en' ? 'No summary available.' : 'აღწერა არ არის.'),
      image: resolveArticleImageUrl(entry.image_url),
      featured: Boolean(entry.featured),
      date: entry.published_at ?? entry.updated_at ?? entry.created_at ?? '',
      link: entry.slug?.trim()
        ? lang === 'en'
          ? `/en/news/${encodeURIComponent(entry.slug.trim())}`
          : `/news/${encodeURIComponent(entry.slug.trim())}`
        : '#',
    };
  });

const featuredIndex = newsItems.findIndex((item) => item.featured);
---

<section class="news content-grid" id="news" aria-labelledby="news-title">
  <div class="container">
    <div class="news-header">
      <div>
        <p class="section-label">{t.news.label}</p>
        <h2 class="section-title" id="news-title" set:html={t.news.title} />
      </div>
    </div>

    <div class="news-grid">
      {
        newsItems.length > 0 ? (
          newsItems.map((item, index) => (
            <Article
              featured={featuredIndex === -1 ? index === 0 : index === featuredIndex}
              image={item.image}
              title={item.title}
              articleTag={item.articleTag}
              content={item.content}
              link={item.link}
              date={item.date}
            />
          ))
        ) : (
          <p class="news-empty">
            {lang === 'en' ? 'No published articles yet.' : 'გამოქვეყნებული სტატიები ჯერ არ არის.'}
          </p>
        )
      }
    </div>

    <a href={archiveHref} class="section-view-all">
      {t.news.linkText}

      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path
          fill-rule="evenodd"
          d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm4.28 10.28a.75.75 0 0 0 0-1.06l-3-3a.75.75 0 1 0-1.06 1.06l1.72 1.72H8.25a.75.75 0 0 0 0 1.5h5.69l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3Z"
          clip-rule="evenodd"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .news {
    padding-block: 4rem;
    background-color: var(--primary);
  }

  .news-grid {
    margin-bottom: 2rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(4, 1fr);
  }

  .news-empty {
    grid-column: 1 / -1;
    margin: 0;
    padding: 1rem;
    border-radius: 10px;
    background: #ffffff;
    color: #475569;
  }

  .section-title {
    color: #ebebeb;
  }
</style>
