---
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
---

<section class="hero overlay min-h-[70vh] flex items-center">
  <div class="max-w-4xl mx-auto text-center text-white grid gap-8">
    <div class="grid gap-4">
      <h2 set:html={t.hero.title} class="text-2xl font-bold" />

      <p set:html={t.hero.description} class="text-md" />
    </div>

    <!-- CTAs -->
    <ul class="flex gap-2 justify-center">
      <li>
        <a
          href="tel:+995551826666"
          class="font-bold bg-white flex items-center rounded-sm px-3 py-2 text-sm text-black border-2 border-transparent"
        >
          {t.topbar.hivAidsHotline}
        </a>
      </li>
      <li>
        <a
          href="#"
          class="font-bold bg-transparent flex items-center border-2 border-white rounded-sm px-3 py-2 text-sm text-white"
          >{t.hero.contactUs}</a
        >
      </li>
    </ul>
  </div>
</section>

<style>
  .font-bold {
    font-family: "BPG Nino Mtavruli Bold", sans-serif;
  }

  .hero {
    background-image: url("../assets/images/clinic.webp");
    background-size: cover;
    background-position: bottom center;
    background-repeat: no-repeat;
  }

  .overlay {
    border-image-source: linear-gradient(
      rgba(21, 93, 252, 0.4),
      rgba(21, 93, 252, 0.6)
    );
    border-image-slice: fill 1;
  }
</style>
