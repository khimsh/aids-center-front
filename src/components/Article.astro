---
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);

interface Props {
  featured?: boolean;
  image: string;
  title: string;
  articleTag: string;
  content: string;
  link: string;
  date?: string;
}

const {
  featured = false,
  image,
  title,
  articleTag,
  content,
  link,
  date = "",
} = Astro.props as Props;

const formattedDate = date
  ? new Intl.DateTimeFormat(lang === "en" ? "en-US" : "ka-GE", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }).format(new Date(date))
  : "";

const toExcerpt = (value: string, wordLimit = 24) => {
  const plain = value
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  if (!plain) {
    return "";
  }

  const words = plain.split(" ");
  const excerpt = words
    .slice(0, Math.max(20, Math.min(wordLimit, 25)))
    .join(" ");
  return `${excerpt.replace(/[.]+$/, "")}...`;
};

const summary = toExcerpt(content);
---

<article class="article-card" data-featured={featured}>
  <figure class="article-figure">
    <img src={image} alt={title} class="article-image" />
    <figcaption class="article-content">
      <h3 class="article-title">{title}</h3>
      <div class="article-meta">
        <span class="article-tag">{articleTag}</span>
        {
          formattedDate ? (
            <time datetime={date} class="article-time">
              {formattedDate}
            </time>
          ) : null
        }
      </div>
    </figcaption>
  </figure>

  <p class="article-summary">
    {summary}
  </p>

  <a href={link} class="article-link"
    >{t.article.linkText}

    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm4.28 10.28a.75.75 0 0 0 0-1.06l-3-3a.75.75 0 1 0-1.06 1.06l1.72 1.72H8.25a.75.75 0 0 0 0 1.5h5.69l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3Z"
        clip-rule="evenodd"></path>
    </svg>
  </a>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
    background-color: #fff;
    padding: 1rem;
    border-radius: 10px;
    box-shadow: 0 16px 40px rgba(2, 49, 95, 0.14);

    &[data-featured="true"] {
      grid-column: span 2;
    }
  }

  .article-figure {
    display: grid;
    gap: 0.875rem;
  }

  .article-content {
    display: grid;
    gap: 0.625rem;
  }

  .article-title {
    margin: 0;
    color: #10233b;
    font-family: "Playfair Display", serif;
    font-size: 1.35rem;
    line-height: 1.2;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .article-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: #dbeafe;
    color: #034485;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .article-time {
    color: #64748b;
    font-size: 0.95rem;
  }

  .article-summary {
    margin: 0;
    color: #334155;
    line-height: 1.7;
    flex: 1;
  }

  .article-link {
    justify-self: start;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 14px;
    font-weight: 500;
    font-family: "Noto Sans Georgian", sans-serif;
    color: var(--primary);
    text-decoration: none;

    &::before {
      content: "";
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 100%;
      height: 2px;
      background-color: var(--primary);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.3s ease;
    }

    &:hover::before {
      transform: scaleX(1);
      transform-origin: left;
    }

    svg {
      flex-shrink: 0;
      width: 24px;
      height: 24px;
    }
  }

  .article-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    object-fit: cover;
  }

  @media (max-width: 760px) {
    .article-card[data-featured="true"] {
      grid-column: auto;
    }

    .article-title {
      font-size: 1.15rem;
    }
  }
</style>
