---
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);

interface Props {
  featured?: boolean;
  image: string;
  title: string;
  articleTag: string;
  content: string;
  link: string;
  date?: string;
}

const {
  featured = false,
  image,
  title,
  articleTag,
  content,
  link,
  date = "",
} = Astro.props as Props;
---

<article class="article-card" data-featured={featured}>
  <figure>
    <img src={image} alt={title} class="article-image" />
    <figcaption class="mt-4">
      <h3 class="article-title">{title}</h3>
      <div class="article-tag">{articleTag}</div>
      <time datetime="" class="article-time">{date}</time>
    </figcaption>
  </figure>

  <p>
    {content}
  </p>

  <a href={link} class="article-link"
    >{t.article.linkText}

    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm4.28 10.28a.75.75 0 0 0 0-1.06l-3-3a.75.75 0 1 0-1.06 1.06l1.72 1.72H8.25a.75.75 0 0 0 0 1.5h5.69l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3Z"
        clip-rule="evenodd"></path>
    </svg>
  </a>
</article>

<style>
  .article-card {
    display: grid;
    gap: 12px;
    background-color: #fff;
    padding: 16px;
    border-radius: 10px;

    &[data-featured="true"] {
      grid-column: span 2;
    }
  }

  .article-link {
    justify-self: start;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 14px;
    font-weight: 500;
    font-family: "Noto Sans Georgian", sans-serif;
    color: var(--primary);
    text-decoration: none;

    &::before {
      content: "";
      position: absolute;
      left: 0;
      bottom: -2px;
      width: 100%;
      height: 2px;
      background-color: var(--primary);
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.3s ease;
    }

    &:hover::before {
      transform: scaleX(1);
      transform-origin: left;
    }

    svg {
      flex-shrink: 0;
      width: 24px;
      height: 24px;
    }
  }

  .article-image {
    width: 100%;
    height: auto;
    border-radius: 10px;
    object-fit: cover;
  }
</style>
