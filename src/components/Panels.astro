---
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
---

<section>
  <div>
    <h2>{t.panels.hivAids.title}</h2>
    <p>{t.panels.hivAids.description}</p>
  </div>
  <div>
    <h2>{t.panels.hepatitis.title}</h2>
    <p>{t.panels.hepatitis.description}</p>
  </div>
  <div>
    <h2>{t.panels.infectiousDiseases.title}</h2>
    <p>{t.panels.infectiousDiseases.description}</p>
  </div>
</section>
