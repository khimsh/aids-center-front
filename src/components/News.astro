---
import Article from "./Article.astro";
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
---

<section class="news content-grid" id="news" aria-labelledby="news-title">
  <div class="container">
    <div class="news-header">
      <div>
        <p class="section-label">{t.news.label}</p>
        <h2 class="section-title" id="news-title" set:html={t.news.title} />
      </div>
    </div>

    <div class="news-grid">
      <Article featured={true} />
      <Article />
      <Article />
    </div>

    <a href="#" class="section-view-all">
      {t.news.linkText}

      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
          d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25Zm4.28 10.28a.75.75 0 0 0 0-1.06l-3-3a.75.75 0 1 0-1.06 1.06l1.72 1.72H8.25a.75.75 0 0 0 0 1.5h5.69l-1.72 1.72a.75.75 0 1 0 1.06 1.06l3-3Z"
          clip-rule="evenodd"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  .news {
    padding-block: 4rem;
    background-color: var(--primary);
  }

  .news-grid {
    margin-bottom: 2rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(4, 1fr);
  }

  .section-title {
    color: #ebebeb;
  }
</style>
