---
import { Icon } from "astro-icon/components";

import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
const homeUrl = lang === "ka" ? "/" : `/${lang}`;
---

<nav aria-label={t.nav.navAriaLabel} class="main-nav">
  <ul class="nav-list">
    <li>
      <a href={homeUrl}>{t.nav.home}</a>
    </li>

    <li>
      <button class="nav-dropdown-btn" aria-expanded="true"
        >{t.nav.hivAids} <Icon name="heroicons:chevron-down" /></button
      >
      <ul class="nav-dropdown">
        <li>
          <a href="#">{t.nav.aboutHivAids}</a>
        </li>
        <li>
          <a href="#">{t.nav.epidemiology}</a>
        </li>
        <li>
          <a href="#">{t.nav.statistics}</a>
        </li>
        <li>
          <a href="#">{t.nav.waysOfTransmission}</a>
        </li>
        <li>
          <a href="#">{t.nav.legislation}</a>
        </li>
        <li>
          <a href="#">{t.nav.qa}</a>
        </li>
      </ul>
    </li>

    <li>
      <a href="#">{t.nav.hepatitis}</a>
    </li>

    <li>
      <a href="#">{t.nav.infectiousDiseases}</a>
    </li>

    <li>
      <button class="nav-dropdown-btn" aria-expanded="true">
        {t.nav.about} <Icon name="heroicons:chevron-down" /></button
      >
      <ul class="nav-dropdown">
        <li>
          <a href="#">{t.nav.about}</a>
        </li>
        <li>
          <a href="#">{t.nav.ourDoctors}</a>
        </li>
      </ul>
    </li>

    <li>
      <button class="nav-dropdown-btn" aria-expanded="true"
        >{t.nav.services} <Icon name="heroicons:chevron-down" /></button
      >
      <ul class="nav-dropdown">
        <li>
          <a href="#">{t.nav.ambulatory}</a>
        </li>
        <li>
          <a href="#">{t.nav.stationary}</a>
        </li>
        <li>
          <a href="#">{t.nav.instrumentalDiagnostics}</a>
        </li>
        <li>
          <a href="#">{t.nav.scientificResearch}</a>
        </li>
        <li>
          <a href="#">{t.nav.laboratory}</a>
        </li>
      </ul>
    </li>

    <li>
      <a href="#">{t.nav.contact}</a>
    </li>
  </ul>
</nav>

<style>
  .main-nav {
    margin-left: auto;
    font-family: "BPG Mrgvlovani Caps", sans-serif;
  }

  .nav-list {
    display: flex;
    gap: 12px;
  }

  .nav-dropdown {
    display: none;
  }

  .nav-dropdown-btn {
    background-color: transparent;
    border: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: inherit;
    cursor: pointer;
  }

  li,
  button {
    font-size: 14px;
  }
</style>

<script>
  // Toggle mobile menu
  const menuToggle = document.querySelector(".menu-toggle");
  const mainNav = document.querySelector(".main-nav");

  if (menuToggle && mainNav) {
    menuToggle.addEventListener("click", () => {
      mainNav.classList.toggle("is-open");
    });
  }
</script>
