---
import { Icon } from "astro-icon/components";

import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
const homeUrl = lang === "ka" ? "/" : `/${lang}`;
---

<nav
  aria-label={t.nav.navAriaLabel}
  class="main-nav xl:block xl:ml-auto absolute xl:static top-full left-0 w-[90%] bg-blue-500 xl:bg-transparent text-white xl:text-black z-50 xl:z-auto hidden"
>
  <ul
    class="flex flex-col xl:justify-end gap-3 xl:flex-row xl:gap-8 py-4 xl:py-0 px-4 xl:px-0"
  >
    <li>
      <a href={homeUrl}>{t.nav.home}</a>
    </li>

    <li>
      <button class="flex gap-1 items-center mb-2" aria-expanded="true"
        >{t.nav.hivAids} <Icon name="heroicons:chevron-down" /></button
      >
      <ul class="pl-4 flex flex-col gap-2 text-sm">
        <li>
          <a href="#">{t.nav.aboutHivAids}</a>
        </li>
        <li>
          <a href="#">{t.nav.epidemiology}</a>
        </li>
        <li>
          <a href="#">{t.nav.statistics}</a>
        </li>
        <li>
          <a href="#">{t.nav.waysOfTransmission}</a>
        </li>
        <li>
          <a href="#">{t.nav.legislation}</a>
        </li>
        <li>
          <a href="#">{t.nav.qa}</a>
        </li>
      </ul>
    </li>

    <li>
      <a href="#">{t.nav.hepatitis}</a>
    </li>

    <li>
      <a href="#">{t.nav.infectiousDiseases}</a>
    </li>

    <li>
      <button class="flex gap-1 items-center mb-2" aria-expanded="true">
        {t.nav.about} <Icon name="heroicons:chevron-down" /></button
      >
      <ul class="pl-4 flex flex-col gap-2 text-sm">
        <li>
          <a href="#">{t.nav.about}</a>
        </li>
        <li>
          <a href="#">{t.nav.ourDoctors}</a>
        </li>
      </ul>
    </li>

    <li>
      <button class="flex gap-1 items-center mb-2" aria-expanded="true"
        >{t.nav.services} <Icon name="heroicons:chevron-down" /></button
      >
      <ul class="pl-4 flex flex-col gap-2 text-sm">
        <li>
          <a href="#">{t.nav.ambulatory}</a>
        </li>
        <li>
          <a href="#">{t.nav.stationary}</a>
        </li>
        <li>
          <a href="#">{t.nav.instrumentalDiagnostics}</a>
        </li>
        <li>
          <a href="#">{t.nav.scientificResearch}</a>
        </li>
        <li>
          <a href="#">{t.nav.laboratory}</a>
        </li>
      </ul>
    </li>

    <li>
      <a href="#">{t.nav.contact}</a>
    </li>
  </ul>
</nav>

<script>
  // Toggle mobile menu
  const menuToggle = document.querySelector(".menu-toggle");
  const mainNav = document.querySelector(".main-nav");

  if (menuToggle && mainNav) {
    menuToggle.addEventListener("click", () => {
      mainNav.classList.toggle("hidden");
    });
  }
</script>
