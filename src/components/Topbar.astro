---
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
---

<div class="topbar bg-blue-600 text-white text-sm">
  <div
    class="container mx-auto flex flex-col gap-1 md:flex-row md:justify-between py-2 px-2 lg:px-0"
  >
    <a href="tel:+995551826666">{t.topbar.hivAidsHotline}: (+995) 551 826 666</a
    >
    <a href="tel:+995595395566">{t.topbar.emergency}: (+995) 595 395 566</a>
  </div>
</div>
