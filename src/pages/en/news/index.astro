---
import Layout from "../../../layouts/Layout.astro";
import ArticlesArchive from "../../../components/ArticlesArchive.astro";
import {
    fetchPublishedArticlesPage,
    getArticlesApiBase,
} from "../../../lib/articles-api";

const apiBase = getArticlesApiBase();
const perPage = 9;
const result = await fetchPublishedArticlesPage(apiBase, 1, perPage);
const totalPages = Math.max(1, Math.ceil(result.total / perPage));
---

<Layout>
    <ArticlesArchive
        lang="en"
        apiBase={apiBase}
        articles={result.items}
        currentPage={1}
        totalPages={totalPages}
    />
</Layout>
