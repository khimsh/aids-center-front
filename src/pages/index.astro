---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import HeroImage from "../assets/hero.png";

import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? "ka") as "ka" | "en";
const t = useTranslations(lang);
---

<Layout>
  <section class="hero">
    <div>
      <h2>
        საქართველოში <strong>B ჰეპატიტის</strong> მართვის სახელმწიფო პროგრამა დაიწყო!
      </h2>

      <p>
        პროგრამის ფარგლებში დიაგნოსტიკური კვლევები და ანტივირუსული <strong
          >მკურნალობა სრულიად უფასოა!</strong
        >
      </p>

      <p>ვიზიტის დაჯავშნა და/ან ინფორმაციის მიღება:</p>

      <ul>
        <li>
          <a href="tel:+995551826666"
            ><Icon name="heroicons:phone" /> (+995) 551 826 666</a
          > - აივ/შიდსი ცხელი ხაზი
        </li>
        <li>
          <address>
            <Icon name="heroicons:map-pin" /> ლუბლიანას ქუჩა #70, თბილისი, საქართველო
          </address>
        </li>
      </ul>
    </div>

    <div>
      <img
        src={HeroImage.src}
        alt="Hepatitis B Awareness"
        class="w-full h-auto object-cover"
      />
    </div>
  </section>
</Layout>

<style>
  h2 {
    font-family: "BPG Nino Mtavruli", sans-serif;
  }
</style>
