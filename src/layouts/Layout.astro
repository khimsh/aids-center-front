---
import "../styles/global.scss";
import Header from "../components/layout/Header.astro";
import Topbar from "../components/layout/Topbar.astro";
import Footer from "../components/layout/Footer.astro";

interface Props {
  title?: string;
}

const siteName =
  (Astro.currentLocale ?? "ka") === "en" ? "AIDS Center" : "AIDS ცენტრი";
const { title = siteName } = Astro.props;
const isEnglish = (Astro.currentLocale ?? "ka") === "en";
---

<html lang={Astro.currentLocale ?? "ka"}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="description"
      content="AIDS Center is a non-governmental organization that has been operating in Georgia since 1996. The main goal of the organization is to prevent the spread of HIV/AIDS and to provide support and care for people living with HIV/AIDS."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={isEnglish ? "lang-en-body" : undefined}>
    <Topbar />
    <div class="container">
      <Header />
    </div>
    <main>
      <slot />
    </main>
    <!-- <Footer /> -->
  </body>
</html>
